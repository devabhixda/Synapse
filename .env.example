SYNAPSE_WEB_PORT=3000
SYNAPSE_API_PORT=8000
# Chat and embeddings are two OpenAI-compatible endpoints, hosted or local.
# From inside the containers, a server on this machine is host.docker.internal.
CHAT_BASE_URL=http://host.docker.internal:8080/v1
EMBEDDING_BASE_URL=http://host.docker.internal:8080/v1
CHAT_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
# Required by anything hosted; a local server that doesn't check keys can leave
# these empty.
CHAT_API_KEY=
EMBEDDING_API_KEY=
# Extra completion budget for a model that reasons before answering, which
# would otherwise spend a call's whole budget thinking and return nothing. Set
# a few thousand for one; a model that answers directly needs none.
CHAT_REASONING_TOKENS=0
INFERENCE_MODE=auto
CRUSTDATA_API_KEY=
