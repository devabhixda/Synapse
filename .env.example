SYNAPSE_WEB_PORT=3000
SYNAPSE_API_PORT=8000
# Chat and embeddings are two OpenAI-compatible endpoints. The defaults below
# are a local Cactus serving Gemma for both; point them at a hosted gateway and
# set the matching key to run inference remotely instead.
CHAT_BASE_URL=http://host.docker.internal:8080/v1
EMBEDDING_BASE_URL=http://host.docker.internal:8080/v1
CHAT_MODEL=google/gemma-4-E2B-it
EMBEDDING_MODEL=google/gemma-4-E2B-it
# Ignored by a local Cactus; required by anything hosted.
CHAT_API_KEY=cactus-local
EMBEDDING_API_KEY=cactus-local
# Extra completion budget for a model that reasons before answering, which
# would otherwise spend a call's whole budget thinking and return nothing.
# Gemma answers directly, so it needs none; set a few thousand for one that
# doesn't.
CHAT_REASONING_TOKENS=0
INFERENCE_MODE=auto
CRUSTDATA_API_KEY=
